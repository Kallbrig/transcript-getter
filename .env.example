# Required: get a token by messaging @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Required: your Telegram user ID (message @userinfobot to get it)
# Comma-separated for multiple users: 123456789,987654321
ALLOWED_USER_IDS=

# Whisper model size: tiny, base, small, medium, large-v2, large-v3
# Recommendation: small for speed, large-v3 for accuracy
# On Mac (CPU only), use tiny or base for reasonable dev speed
WHISPER_MODEL=small

# Compute type: leave blank for auto-detection
# Auto-detects: float16 on NVIDIA GPU, int8 on CPU
WHISPER_COMPUTE_TYPE=

# Language hint for Whisper (e.g. "en"). Leave blank for auto-detect.
WHISPER_LANGUAGE=

# Working directory for temporary audio and transcript files
WORK_DIR=/tmp/transcript_bot

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
